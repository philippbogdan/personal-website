---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const essays = await getCollection('essays');
  return essays
    .filter((e) => import.meta.env.DEV || !e.data.draft)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const band = entry.data.coverBand ?? entry.data.cover;
---
<Base title={entry.data.title} description={entry.data.description}
      card={entry.data.card} cardAlt={entry.data.cardAlt}>
  {entry.data.cover && (
    <div class="hero">
      <Image class="hero-img hero-img-wide" src={entry.data.cover} alt={entry.data.coverAlt ?? ''}
             widths={[1280, 1920, 2560, 3840]} sizes="100vw"
             format="avif" quality={80}
             loading="eager" fetchpriority="high" />
      <Image class="hero-img hero-img-band" src={band} alt={entry.data.coverAlt ?? ''}
             widths={[780, 1280]} sizes="100vw"
             format="avif" quality={80}
             loading="eager" fetchpriority="high" />
    </div>
    <script>
      // Stretchy hero: rubber-banding past the top scales the banner from its
      // bottom edge, so the pull reveals more photograph (cropping the sides)
      // instead of white. scrollY goes negative during the overscroll.
      const img = document.querySelector('.hero-img-band');
      if (img) {
        let raf = 0;
        const apply = () => {
          raf = 0;
          const y = Math.min(0, window.scrollY);
          const h = img.getBoundingClientRect().height || 1;
          img.style.transform = y < 0 ? `scale(${1 + (-y) / h})` : '';
        };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(apply); }, { passive: true });
      }
    </script>
  )}

  <a class="back" href="/">&larr;&nbsp;Back</a>

  <header class="essay-head">
    <h1 class="essay-title">{entry.data.title}</h1>
  </header>

  <article class="prose">
    <Content />
  </article>

  <p class="more"><a href="/">More writing&nbsp;&rarr;</a></p>
</Base>
