---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const essays = await getCollection('essays');
  return essays
    .filter((e) => import.meta.env.DEV || !e.data.draft)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
// The same photograph as a CSS url, for the overscroll continuation painted
// above the hero (.hero::before in global.css).
const heroBg = entry.data.cover
  ? await getImage({ src: entry.data.cover, width: 1280, format: 'avif', quality: 80 })
  : null;
const band = entry.data.coverBand ?? entry.data.cover;
const bandBg = band
  ? await getImage({ src: band, width: 1280, format: 'avif', quality: 80 })
  : null;
---
<Base title={entry.data.title} description={entry.data.description}
      card={entry.data.card} cardAlt={entry.data.cardAlt}>
  {entry.data.cover && (
    <div class="hero" style={heroBg ? `--hero-bg: url(${heroBg.src}); --hero-bg-band: url(${bandBg.src})` : undefined}>
      <Image class="hero-img hero-img-wide" src={entry.data.cover} alt={entry.data.coverAlt ?? ''}
             widths={[1280, 1920, 2560, 3840]} sizes="100vw"
             format="avif" quality={80}
             loading="eager" fetchpriority="high" />
      <Image class="hero-img hero-img-band" src={band} alt={entry.data.coverAlt ?? ''}
             widths={[780, 1280]} sizes="100vw"
             format="avif" quality={80}
             loading="eager" fetchpriority="high" />
    </div>
  )}

  <a class="back" href="/">&larr;&nbsp;Back</a>

  <header class="essay-head">
    <h1 class="essay-title">{entry.data.title}</h1>
  </header>

  <article class="prose">
    <Content />
  </article>

  <p class="more"><a href="/">More writing&nbsp;&rarr;</a></p>
</Base>
