---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../config';

export const getStaticPaths = (async () => {
  const essays = await getCollection('essays');
  return essays
    .filter((e) => import.meta.env.DEV || !e.data.draft)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const fullDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const words = entry.body?.trim().split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));
---
<Base title={entry.data.title} description={entry.data.description}>
  {entry.data.cover && (
    <div class="hero">
      <Image class="hero-img" src={entry.data.cover} alt={entry.data.coverAlt ?? ''}
             widths={[1280, 1920, 2560, 3840]} sizes="100vw"
             format="avif" quality={80}
             loading="eager" fetchpriority="high" />
    </div>
  )}

  <a class="back" href="/">&larr;&nbsp;{site.name}</a>

  <header class="essay-head">
    <h1 class="essay-title">{entry.data.title}</h1>
    {entry.data.description && <p class="essay-desc">{entry.data.description}</p>}
    <p class="meta">
      {fullDate(entry.data.date)}
      {' · '}{minutes} min read
      {entry.data.updated && <>{' · updated '}{fullDate(entry.data.updated)}</>}
    </p>
  </header>

  <article class="prose">
    <Content />
  </article>

  <p class="more"><a href="/">More writing&nbsp;&rarr;</a></p>
</Base>
